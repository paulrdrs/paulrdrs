{
  "name": "@paulrdrs/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sync": "pnpm --filter @paulrdrs/notion-sync build",
    "build:web": "pnpm --filter @paulrdrs/web build:worker",
    "check:deps": "node scripts/check-exact-deps.ts",
    "check:no-js": "node scripts/check-no-js.ts",
    "commit": "git-cz",
    "db:generate": "pnpm --filter @paulrdrs/database db:generate",
    "db:migrate": "wrangler d1 migrations apply DB --config apps/web/wrangler.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --config apps/web/wrangler.jsonc --remote",
    "deploy:sync": "pnpm --filter @paulrdrs/notion-sync run deploy",
    "deploy:web": "pnpm --filter @paulrdrs/web run deploy",
    "dev": "pnpm --filter @paulrdrs/web dev",
    "dev:all": "pnpm --parallel --filter @paulrdrs/web --filter @paulrdrs/notion-sync dev",
    "dev:sync": "pnpm --filter @paulrdrs/notion-sync dev",
    "fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome check",
    "prepare": "is-ci || husky",
    "preview:web": "pnpm --filter @paulrdrs/web preview",
    "sync:local": "pnpm --filter @paulrdrs/notion-sync trigger:local",
    "sync:instances": "pnpm --filter @paulrdrs/notion-sync instances",
    "sync:trigger": "pnpm --filter @paulrdrs/notion-sync trigger",
    "test": "pnpm --filter @paulrdrs/content test && pnpm --filter @paulrdrs/database test && pnpm --filter @paulrdrs/web test && pnpm --filter @paulrdrs/notion-sync test",
    "test:web:watch": "pnpm --filter @paulrdrs/web test:watch",
    "typegen": "pnpm --filter @paulrdrs/web cf-typegen && pnpm --filter @paulrdrs/notion-sync cf-typegen",
    "typecheck": "pnpm --filter @paulrdrs/content typecheck && pnpm --filter @paulrdrs/database typecheck && pnpm --filter @paulrdrs/web typecheck && pnpm --filter @paulrdrs/notion-sync typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@commitlint/types": "21.0.1",
    "commitizen": "4.3.1",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.105.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.14.0"
}
