{
  "name": "@paulrdrs/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sync": "pnpm --filter @paulrdrs/notion-sync build",
    "build:web": "pnpm --filter @paulrdrs/web build",
    "commit": "git-cz",
    "db:generate": "pnpm --filter @paulrdrs/database db:generate",
    "db:migrate": "pnpm --filter @paulrdrs/database exec drizzle-kit migrate --config drizzle.migrate.config.ts",
    "dev": "railway run --environment production --service web -- pnpm --filter @paulrdrs/web dev",
    "fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome check",
    "prepare": "is-ci || husky",
    "sync:run": "pnpm --filter @paulrdrs/notion-sync sync:run",
    "test": "pnpm --filter @paulrdrs/content test && pnpm --filter @paulrdrs/database test && pnpm --filter @paulrdrs/web test && pnpm --filter @paulrdrs/notion-sync test",
    "test:web:watch": "pnpm --filter @paulrdrs/web test:watch",
    "typecheck": "pnpm --filter @paulrdrs/content typecheck && pnpm --filter @paulrdrs/database typecheck && pnpm --filter @paulrdrs/web typecheck && pnpm --filter @paulrdrs/notion-sync typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@commitlint/types": "21.0.1",
    "commitizen": "4.3.1",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "typescript": "6.0.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": "24.18.0",
    "railway": "5.41.2"
  },
  "packageManager": "pnpm@11.14.0"
}
