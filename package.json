{
  "name": "@paulrdrs/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @paulrdrs/web build",
    "build:worker": "pnpm --filter @paulrdrs/web build:worker",
    "cf-typegen": "pnpm --filter @paulrdrs/web cf-typegen",
    "check:deps": "node scripts/check-exact-deps.ts",
    "check:no-js": "node scripts/check-no-js.ts",
    "commit": "git-cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --config apps/web/wrangler.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --config apps/web/wrangler.jsonc --remote",
    "deploy": "pnpm --filter @paulrdrs/web deploy",
    "dev": "pnpm --filter @paulrdrs/web dev",
    "format": "biome format --write",
    "lint": "biome check",
    "prepare": "is-ci || husky",
    "preview": "pnpm --filter @paulrdrs/web preview",
    "start": "pnpm --filter @paulrdrs/web start",
    "test": "pnpm --filter @paulrdrs/web test",
    "test:watch": "pnpm --filter @paulrdrs/web test:watch",
    "typecheck": "pnpm --filter @paulrdrs/web typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@commitlint/types": "21.0.1",
    "commitizen": "4.3.1",
    "drizzle-kit": "0.31.10",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.105.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.5.2"
}
