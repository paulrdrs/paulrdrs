{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "e590ee3208ef5a3a9e75473b8beaa344",
  "name": "notion-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {
    "required": [
      "NOTION_TOKEN",
      "NOTION_POSTS_DB_ID",
      "NOTION_PHOTOGRAPHY_PROJECTS_DB_ID",
      "NOTION_SOFTWARE_PROJECTS_DB_ID",
      "NOTION_PHOTOS_DB_ID",
      "NOTION_PAGES_DB_ID"
    ]
  },
  "workflows": [
    {
      "name": "notion-sync",
      "binding": "SYNC_WORKFLOW",
      "class_name": "NotionSyncWorkflow"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paulrdrs",
      "database_id": "c988153c-6cba-4302-869b-1dfae43cbb27",
      "migrations_dir": "../../packages/database/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "paulrdrs-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
