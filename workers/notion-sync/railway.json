{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @paulrdrs/notion-sync build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @paulrdrs/notion-sync sync:run",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
